          "path": [
            "api",
            "v1",
            "master-outlet",
            "{{master_restaurant_id}}",
            "verify-location"
          ]
        }
      }
    },
    {
      "name": "Public - Verify Location No Service",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pincode\": \"999999\",\n  \"limit\": 20,\n  \"offset\": 1\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/master-outlet/{{master_restaurant_id}}/verify-location",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "master-outlet",
            "{{master_restaurant_id}}",
            "verify-location"
          ]
        }
      }
    },
    {
      "name": "Management - Create Group",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"master_restaurant_id\": 478,\n  \"name\": \"18march Group\",\n  \"slug\": \"18march-group\",\n  \"domain\": \"18march.mygenie.online\",\n  \"logo\": null,\n  \"status\": 1\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/master-outlet/group",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "master-outlet",
            "group"
          ]
        }
      }
    },
    {
      "name": "Management - Update Group",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"18march Group\",\n  \"domain\": \"18march.mygenie.online\",\n  \"status\": 1\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/master-outlet/group/{{group_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "master-outlet",
            "group",
            "{{group_id}}"
          ]
        }
      }
    },
    {
      "name": "Management - Set Group Restaurants",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"replace\": true,\n  \"restaurants\": [\n    {\n      \"restaurant_id\": 478,\n      \"is_master\": 1,\n      \"sort_order\": 0,\n      \"status\": 1\n    },\n    {\n      \"restaurant_id\": 510,\n      \"is_master\": 0,\n      \"sort_order\": 1,\n      \"status\": 1\n    },\n    {\n      \"restaurant_id\": 675,\n      \"is_master\": 0,\n      \"sort_order\": 2,\n      \"status\": 1\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/master-outlet/group/{{group_id}}/restaurants",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "master-outlet",
            "group",
            "{{group_id}}",
            "restaurants"
          ]
        }
      }
    },
    {
      "name": "Management - Remove Restaurant From Group",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/master-outlet/group/{{group_id}}/restaurants/{{branch_restaurant_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "master-outlet",
            "group",
            "{{group_id}}",
            "restaurants",
            "{{branch_restaurant_id}}"
          ]
        }
      }
    },

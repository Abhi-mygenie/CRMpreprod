{
  "info": {
    "name": "MyGenie Master Outlet Group APIs",
    "description": "Postman collection for master outlet group, branch mapping, delivery area setup, and customer location verification.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://preprod.mygenie.online"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "master_restaurant_id",
      "value": "478"
    },
    {
      "key": "group_id",
      "value": "1"
    },
    {
      "key": "branch_restaurant_id",
      "value": "510"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Public - Get Master Outlet Group",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/master-outlet/{{master_restaurant_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "master-outlet",
            "{{master_restaurant_id}}"
          ]
        }
      }
    },
    {
      "name": "Public - Verify Location By Pincode",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pincode\": \"110001\",\n  \"limit\": 20,\n  \"offset\": 1\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/master-outlet/{{master_restaurant_id}}/verify-location",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "master-outlet",
            "{{master_restaurant_id}}",
            "verify-location"
          ]
        }
      }
    },
    {
      "name": "Public - Verify Location By Pincode And LatLng",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pincode\": \"110001\",\n  \"latitude\": 28.6139,\n  \"longitude\": 77.2090,\n  \"address\": \"Connaught Place, New Delhi\",\n  \"limit\": 20,\n  \"offset\": 1\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/master-outlet/{{master_restaurant_id}}/verify-location",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "master-outlet",
            "{{master_restaurant_id}}",
            "verify-location"
          ]
        }
      }
    },
    {
